FUTURES_KB_DB=data/futures_kb.sqlite3
FUTURES_KB_CRAWLER_CONFIG=config/crawlers.local.json
FUTURES_KB_RAW_DIR=data/raw
FUTURES_KB_API_KEY=
FUTURES_KB_API_HOST=127.0.0.1
FUTURES_KB_API_PORT=8787

# native | futures-intel
FUTURES_KB_BACKEND=native
FUTURES_INTEL_ROOT=%LOCALAPPDATA%\FuturesIntelTool
FUTURES_INTEL_CONFIG=
FUTURES_INTEL_TIMEOUT_SECONDS=300
FUTURES_KB_FETCH_5M=1
FUTURES_KB_5M_TIMEOUT_SECONDS=10
